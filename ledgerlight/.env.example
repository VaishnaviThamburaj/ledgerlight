# Copy this file to ".env.local" and fill in the values.
# .env.local is private: it is never uploaded to GitHub.

# --- AI reader (required to read real PDFs; the sample works without it) ---
# Get it at https://console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=

# Optional: which Claude model reads documents (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: which reader to use (default: claude). Add more in src/lib/extraction/.
# EXTRACTION_PROVIDER=claude

# --- Supabase (optional locally; required on Vercel for permanent storage) ---
# Supabase dashboard -> Project Settings -> API (or "API Keys")
SUPABASE_URL=
# The SECRET key (starts with sb_secret_...) or the legacy "service_role" key.
# Never the "anon"/"publishable" key. Keep this private.
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=invoices

# --- Front-door password (strongly recommended once deployed online) ---
# When set, the browser asks for a password before showing the app.
APP_PASSWORD=
